# SkyTrack local secrets — copy to .env, never commit. See docs/ARCHITECTURE.md.
PORT=3000
POLL_MS=30000
# Primary ADS-B quota (optional; anonymous works with lower quota).
OPENSKY_USER=
OPENSKY_PASS=
# Sea live path (parked until configured; demo vessels otherwise).
SEA_POLL_MS=60000
AIS_URL=
AIS_KEY=
# Streets live path (parked until a per-city JSON vehicle feed is configured;
# GTFS-RT protobuf cities stay parked per docs/PRD.md out-of-scope).
STREET_POLL_MS=30000
TRANSIT_URL=
# Space: CelesTrak groups are keyless; refresh is hourly and polite.
TLE_GROUPS=stations,visual
TLE_REFRESH_MS=3600000
